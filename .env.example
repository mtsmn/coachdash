# APP_URL: Public URL where this applet is hosted (used for OAuth callbacks)
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# SUPABASE AUTHENTICATION & POSTGRES (MILESTONE 1-2)
# ------------------------------------------------------------------------------
# Public browser-safe configuration (exposed to Vite SPA for coach sign-in only)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only Supabase configuration (NEVER prefix with VITE_)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only email authorizing initial bootstrap of the single owner coach row
OWNER_COACH_EMAIL=""

# Server-only 32-byte AES-256-GCM key (64-char hex or base64) for encrypting stored OAuth tokens
TOKEN_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# INTERVALS.ICU AUTHENTICATION (SERVER-SIDE ONLY; NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# Only required credential for Personal API-Key authentication (read-only access):
INTERVALS_ICU_API_KEY=""

# Optional Intervals.icu OAuth 2.0 credentials (NOT required for Personal API-Key authentication)
INTERVALS_ICU_CLIENT_ID=""
INTERVALS_ICU_CLIENT_SECRET=""
INTERVALS_ICU_REDIRECT_URI=""

# FINAL SURGE SERVER-SIDE CREDENTIALS (FUTURE LIVE SYNC)
FINALSURGE_CLIENT_ID=""
FINALSURGE_CLIENT_SECRET=""

# OPTIONAL GEMINI API KEY (NOT REQUIRED FOR RULES-BASED COACHING ENGINE)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
